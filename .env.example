# Supabase Postgres. DATABASE_URL is the pooled (transaction-mode, port 6543)
# connection the app uses at runtime — required for serverless (Vercel).
# DIRECT_URL is the direct connection (port 5432) Prisma needs for running
# migrations. Get both from: Supabase project -> Connect -> ORM -> Prisma.
DATABASE_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

# Google Gemini API key (Gemini Flash is used for extraction, scoring, briefs, and email drafts).
GEMINI_API_KEY=

# Resend API key — left blank intentionally. Fill in when ready to send real email.
RESEND_API_KEY=

# "From" address for outgoing email via Resend. Do not set a production domain
# until Arjun provides one — until then, all recipients should be treated as test addresses.
RESEND_FROM_EMAIL="Kargo Hiring <onboarding@resend.dev>"

# Configurable shortlist size (top N per role get a brief + invite draft; see rubric.txt's
# note that no cutoff number was specified in the rubric itself — this is a pipeline setting).
SHORTLIST_SIZE=5
